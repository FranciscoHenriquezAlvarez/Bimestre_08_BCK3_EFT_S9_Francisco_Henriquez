FROM eclipse-temurin:17-jdk AS build
WORKDIR /workspace
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY shared-events shared-events
COPY authorization-server authorization-server
COPY config-server config-server
COPY eureka-server eureka-server
COPY core-banking-service core-banking-service
COPY bff-web-service bff-web-service
COPY bff-mobile-service bff-mobile-service
COPY bff-atm-service bff-atm-service
COPY payment-service payment-service
COPY customer-service customer-service
# Maven se valida en el host antes de construir; evita repetir las pruebas dentro de la imagen.
RUN chmod +x mvnw && ./mvnw -f pom.xml clean package -DskipTests

FROM eclipse-temurin:17-jre
ARG MODULE
LABEL org.opencontainers.image.title="${MODULE}"
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/${MODULE}/target/${MODULE}-1.0.0.jar /app/app.jar
COPY docker/batch-init.sh /usr/local/bin/batch-init.sh
RUN chmod +x /usr/local/bin/batch-init.sh
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
